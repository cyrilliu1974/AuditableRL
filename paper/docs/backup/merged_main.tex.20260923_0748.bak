\title{From Replayable Traces to Provenance-Aware Rule Fusion:\\ Auditable Reinforcement Learning at the Rule Level}
\author{Liu Hung Ming\thanks{PARRAWA AI, \texttt{cyril.liu@gmail.com} }}

